---
import { getCollection } from "astro:content";
import PostList from "@/components/visual/PostList.astro";
import Pagination from "@/components/visual/Pagination.astro";
import SectionHeader from "@/components/visual/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pagePath, paginate, totalPages } from "@/lib/routing/pagination";
import "@/styles/home.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);
  const sorted = posts.sort((a, b) => {
    const dateA = new Date(a.data.date).getTime();
    const dateB = new Date(b.data.date).getTime();
    if (dateB !== dateA) return dateB - dateA;
    return b.data.permalink.localeCompare(a.data.permalink);
  });
  const pages = totalPages(sorted.length);
  return Array.from({ length: pages - 1 }, (_, index) => index + 2).map(
    (page) => ({
      params: { page: String(page) },
      props: { sorted, page },
    }),
  );
}

const { sorted, page } = Astro.props;
const pages = totalPages(sorted.length);
const pagePosts = paginate(sorted, page);
---

<BaseLayout
  title={`第 ${page} 页`}
  description="深度学习、扩散模型、流匹配与数值分析的技术笔记"
>
  <div class="pagination-page-container">
    <SectionHeader
      title="全部文章"
      countText={`第 ${page} 页 / 共 ${pages} 页`}
    />
    <PostList posts={pagePosts} />
    <Pagination currentPage={page} pages={pages} href={pagePath} />
  </div>
</BaseLayout>

<style>
  .pagination-page-container {
    padding: 1.5rem 0;
    width: 100%;
  }
</style>
