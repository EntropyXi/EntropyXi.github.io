---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home.css";
---

<BaseLayout title="搜索" description="全站文章搜索">
  <div class="search-container">
    <div class="search-header">
      <h1 class="page-title">全站搜索</h1>
      <p class="page-intro">输入中文或英文关键词，实时索引 30 篇技术文章</p>
    </div>

    <noscript>
      <div
        class="search-noscript-notice"
        role="region"
        aria-label="无 JavaScript 提示"
      >
        <p class="search-noscript-text">
          当前浏览器未启用
          JavaScript，实时站内搜索功能不可用。您可以通过以下索引页面浏览全部内容：
        </p>
        <div class="search-noscript-links">
          <a href="/archives/" class="search-noscript-link">全站归档</a>
          <a href="/categories/" class="search-noscript-link">文章分类</a>
          <a href="/tags/" class="search-noscript-link">标签列表</a>
        </div>
      </div>
    </noscript>

    <form class="search-form" role="search" onsubmit="return false">
      <label for="search-input" class="visually-hidden">搜索文章</label>
      <div class="search-input-wrapper">
        <svg
          class="search-input-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
        </svg>
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          placeholder="搜索扩散模型、流匹配、SDE、数值分析等..."
        />
        <kbd class="search-kbd-hint">/</kbd>
      </div>
    </form>

    <div id="search-status" class="search-status" aria-live="polite"></div>
    <ul class="search-results" id="search-results" aria-live="polite"></ul>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border-width: 0;
  }

  .search-status {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    min-height: 1.5rem;
  }

  .search-noscript-notice {
    padding: 1.25rem;
    margin-bottom: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .search-noscript-text {
    margin: 0 0 1rem;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .search-noscript-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .search-noscript-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .search-noscript-link:hover,
  .search-noscript-link:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }
</style>

<script>
  import { registerClientFeature } from "@/lib/client/lifecycle";
  import { initializeSearch } from "@/lib/client/search";

  registerClientFeature("search", initializeSearch);
</script>
