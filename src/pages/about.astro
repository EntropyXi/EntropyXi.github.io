---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/visual/SectionHeader.astro";
import "@/styles/prose.css";
---

<BaseLayout title="关于本人" description="关于 EntropyXi">
  <div class="about-container">
    <header class="about-header">
      <div class="about-avatar-wrapper" aria-hidden="true">
        <span class="about-avatar-symbol">Ξ</span>
      </div>
      <div class="about-header-text">
        <h1 class="page-title">关于本人</h1>
        <p class="about-role">
          EntropyXi · Software Engineering Student @ SCAU
        </p>
      </div>
    </header>

    <article class="prose about-card">
      <SectionHeader title="个人简介" countText="Profile" />
      <p>
        华南农业大学软件工程专业（Software Engineering Student at
        SCAU），专注于计算机科学数理基础与前沿生成式 AI 算法理论。
      </p>

      <SectionHeader
        title="核心研究与技术兴趣"
        countText="Research Interests"
      />
      <ul>
        <li>
          <strong>生成建模</strong>：扩散模型 (Diffusion Models)、流匹配 (Flow
          Matching)、连续正则化流 (CNF)
        </li>
        <li>
          <strong>数理推导与优化</strong>：数值分析、随机微分方程 (SDE /
          ODE)、高性能计算
        </li>
        <li>
          <strong>前沿探索</strong>：图像超分辨率
          (Super-Resolution)、AI4Science、强化学习 (RL) 与 LLM
        </li>
      </ul>

      <SectionHeader title="学术与工程交流" countText="Contact" />
      <p>欢迎就扩散模型、流匹配与数理优化问题进行探讨：</p>
      <div class="about-contact-links">
        <a
          href="mailto:zengzhaoxi.g@gmail.com"
          class="about-contact-btn"
          aria-label="发送邮件给 EntropyXi"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>EMAIL: zengzhaoxi.g@gmail.com</span>
        </a>
        <a
          href="https://github.com/EntropyXi"
          target="_blank"
          rel="noopener noreferrer"
          class="about-contact-btn"
          aria-label="访问 EntropyXi 的 GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          <span>GitHub: github.com/EntropyXi</span>
        </a>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 0;
    width: 100%;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-default);
  }

  .about-avatar-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface-base);
    border: 2px solid var(--color-accent-primary);
    box-shadow: 0 0 25px var(--color-accent-primary-glow);
    flex-shrink: 0;
  }

  .about-avatar-symbol {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-accent-primary);
  }

  .about-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .about-header .page-title {
    margin: 0;
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .about-role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-accent-cyan);
    font-weight: 500;
  }

  .about-card {
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    background: var(--color-surface-base);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .about-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .about-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard),
      background-color var(--motion-duration-fast) var(--motion-ease-standard),
      box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
      transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .about-contact-btn:hover,
  .about-contact-btn:focus-visible {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: var(--color-accent-primary-subtle);
    box-shadow: 0 0 16px var(--color-accent-primary-glow);
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .about-contact-btn:hover {
      transform: translateX(3px);
    }
  }

  @media (width <= 40rem) {
    .about-card {
      padding: 1.25rem;
    }

    .about-header {
      gap: 1rem;
    }

    .about-avatar-wrapper {
      width: 3.75rem;
      height: 3.75rem;
    }

    .about-avatar-symbol {
      font-size: 1.8rem;
    }
  }
</style>
