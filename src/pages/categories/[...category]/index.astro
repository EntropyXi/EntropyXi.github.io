---
import { getCollection } from "astro:content";
import Pagination from "@/components/visual/Pagination.astro";
import PostList from "@/components/visual/PostList.astro";
import SectionHeader from "@/components/visual/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  buildCategoryPath,
  postsInCategory,
  sortPostsByDateDesc,
} from "@/lib/content/aggregate";
import { paginate, totalPages } from "@/lib/routing/pagination";

export async function getStaticPaths() {
  const allPosts = sortPostsByDateDesc(
    await getCollection("blog", ({ data }) => data.draft !== true),
  );
  const paths = new Set<string>();
  for (const post of allPosts) {
    for (let index = 1; index <= post.data.categories.length; index += 1) {
      paths.add(post.data.categories.slice(0, index).join("/"));
    }
  }
  return [...paths].map((path) => ({
    params: { category: path },
    props: { allPosts, path },
  }));
}

const { allPosts, path } = Astro.props;
const segments = path.split("/");
const posts = sortPostsByDateDesc(postsInCategory(allPosts, segments));
const pages = totalPages(posts.length);
const pagePosts = paginate(posts, 1);
const basePath = buildCategoryPath(segments);
const href = (page: number) =>
  page === 1 ? basePath : `${basePath}page/${page}/`;
---

<BaseLayout title={`分类：${path}`} description={`分类：${path}`}>
  <div class="category-detail-container">
    <SectionHeader
      title={`分类：${path}`}
      countText={`共 ${posts.length} 篇技术笔记`}
    />
    <PostList posts={pagePosts} />
    <Pagination currentPage={1} pages={pages} href={href} />
  </div>
</BaseLayout>

<style>
  .category-detail-container {
    padding: 1.5rem 0;
    width: 100%;
  }
</style>
