---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildCategoryPath, postsInCategory } from "@/lib/content/aggregate";
import "@/styles/home.css";

const posts = await getCollection("blog", ({ data }) => data.draft !== true);
const categoryPaths = [
  ...new Set(
    posts.flatMap((post) =>
      post.data.categories.map((_, index, array) =>
        array.slice(0, index + 1).join("/"),
      ),
    ),
  ),
].sort();

const categoriesWithCount = categoryPaths.map((catPath) => {
  const segments = catPath.split("/");
  const count = postsInCategory(posts, segments).length;
  return {
    path: catPath,
    segments,
    name: segments[segments.length - 1],
    count,
  };
});
---

<BaseLayout title="分类" description="全站文章分类导览">
  <div class="category-index-header">
    <h1 class="page-title">文章分类</h1>
    <p class="page-intro">共 {categoryPaths.length} 个分类维度</p>
  </div>

  <div class="badge-grid">
    {
      categoriesWithCount.map((cat) => (
        <a href={buildCategoryPath(cat.segments)} class="category-card">
          <span class="category-card-name">{cat.path}</span>
          <span class="tag-count">{cat.count} 篇</span>
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  .category-index-header {
    margin-bottom: 2rem;
  }

  .category-card-name {
    font-weight: 500;
  }
</style>
