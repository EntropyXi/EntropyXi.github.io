---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/visual/Hero.astro";
import SectionHeader from "@/components/visual/SectionHeader.astro";
import PostList from "@/components/visual/PostList.astro";
import Pagination from "@/components/visual/Pagination.astro";
import { pagePath, paginate, totalPages } from "@/lib/routing/pagination";
import "@/styles/home.css";

const posts = await getCollection("blog", ({ data }) => data.draft !== true);
const sorted = posts.sort((a, b) => {
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  if (dateB !== dateA) return dateB - dateA;
  return b.data.permalink.localeCompare(a.data.permalink);
});
const pages = totalPages(sorted.length);
const pagePosts = paginate(sorted, 1);
---

<BaseLayout
  isHome={true}
  title=""
  description="聚焦深度学习、扩散模型、流匹配与数值分析的技术笔记"
>
  <Hero slot="hero" />

  <section
    id="latest-posts"
    class="home-posts-section"
    aria-label="最新文章"
    tabindex="-1"
  >
    <SectionHeader title="最新文章" countText={`共 ${sorted.length} 篇笔记`} />

    <PostList posts={pagePosts} />

    <Pagination currentPage={1} pages={pages} href={pagePath} />
  </section>
</BaseLayout>

<style>
  .home-posts-section {
    margin-top: 1rem;
    width: 100%;
  }

  .home-posts-section:focus:not(:focus-visible) {
    outline: none;
  }
</style>
