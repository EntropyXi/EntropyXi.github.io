---
import { getCollection } from "astro:content";
import Pagination from "@/components/visual/Pagination.astro";
import PostList from "@/components/visual/PostList.astro";
import SectionHeader from "@/components/visual/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortPostsByDateDesc } from "@/lib/content/aggregate";
import { paginate, totalPages } from "@/lib/routing/pagination";
import "@/styles/home.css";

const posts = sortPostsByDateDesc(
  await getCollection("blog", ({ data }) => data.draft !== true),
);
const pages = totalPages(posts.length);
const pagePosts = paginate(posts, 1);
const href = (page: number) =>
  page === 1 ? "/archives/" : `/archives/page/${page}/`;
---

<BaseLayout title="全站归档" description="全部文章归档">
  <div class="archive-container">
    <SectionHeader
      title="全站归档"
      countText={`共 ${posts.length} 篇技术笔记`}
    />
    <PostList posts={pagePosts} />
    <Pagination currentPage={1} pages={pages} href={href} />
  </div>
</BaseLayout>

<style>
  .archive-container {
    padding: 1.5rem 0;
    width: 100%;
  }
</style>
