---
import { getCollection } from "astro:content";
import PaginationNav from "@/components/content/PaginationNav.astro";
import PostList from "@/components/content/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { postsInYear, sortPostsByDateDesc } from "@/lib/content/aggregate";
import { paginate, totalPages } from "@/lib/routing/pagination";
import "@/styles/home.css";

export async function getStaticPaths() {
  const allPosts = sortPostsByDateDesc(
    await getCollection("blog", ({ data }) => data.draft !== true),
  );
  const years = [
    ...new Set(allPosts.map((post) => post.data.date.slice(0, 4))),
  ];
  return years.map((year) => ({
    params: { year },
    props: { allPosts, year },
  }));
}

const { allPosts, year } = Astro.props;
const posts = sortPostsByDateDesc(postsInYear(allPosts, year));
const pages = totalPages(posts.length);
const pagePosts = paginate(posts, 1);
const href = (page: number) =>
  page === 1 ? `/archives/${year}/` : `/archives/${year}/page/${page}/`;
---

<BaseLayout title={`归档 ${year}`} description={`${year} 年文章归档`}>
  <h1 class="page-title">{year} 年归档</h1>
  <PostList posts={pagePosts} />
  <PaginationNav currentPage={1} pages={pages} href={href} />
</BaseLayout>
