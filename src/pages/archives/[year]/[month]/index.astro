---
import { getCollection } from "astro:content";
import PaginationNav from "@/components/content/PaginationNav.astro";
import PostList from "@/components/content/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { postsInYearMonth, sortPostsByDateDesc } from "@/lib/content/aggregate";
import { paginate, totalPages } from "@/lib/routing/pagination";
import "@/styles/home.css";

export async function getStaticPaths() {
  const allPosts = sortPostsByDateDesc(
    await getCollection("blog", ({ data }) => data.draft !== true),
  );
  const keys = new Set(
    allPosts.map(
      (post) => `${post.data.date.slice(0, 4)}/${post.data.date.slice(5, 7)}`,
    ),
  );
  return [...keys].map((key) => {
    const [year, month] = key.split("/") as [string, string];
    return { params: { year, month }, props: { allPosts, year, month } };
  });
}

const { allPosts, year, month } = Astro.props;
const posts = sortPostsByDateDesc(postsInYearMonth(allPosts, year, month));
const pages = totalPages(posts.length);
const pagePosts = paginate(posts, 1);
const href = (page: number) =>
  page === 1
    ? `/archives/${year}/${month}/`
    : `/archives/${year}/${month}/page/${page}/`;
---

<BaseLayout
  title={`归档 ${year}-${month}`}
  description={`${year} 年 ${month} 月文章归档`}
>
  <h1 class="page-title">{year}-{month} 归档</h1>
  <PostList posts={pagePosts} />
  <PaginationNav currentPage={1} pages={pages} href={href} />
</BaseLayout>
