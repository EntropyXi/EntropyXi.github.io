---
import { getCollection } from "astro:content";
import Pagination from "@/components/visual/Pagination.astro";
import PostList from "@/components/visual/PostList.astro";
import SectionHeader from "@/components/visual/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortPostsByDateDesc } from "@/lib/content/aggregate";
import { paginate, totalPages } from "@/lib/routing/pagination";

export async function getStaticPaths() {
  const posts = sortPostsByDateDesc(
    await getCollection("blog", ({ data }) => data.draft !== true),
  );
  const pages = totalPages(posts.length);
  return Array.from({ length: pages - 1 }, (_, index) => index + 2).map(
    (page) => ({
      params: { page: String(page) },
      props: { posts, page },
    }),
  );
}

const { posts, page } = Astro.props;
const pages = totalPages(posts.length);
const pagePosts = paginate(posts, page);
const href = (pageNumber: number) =>
  pageNumber === 1 ? "/archives/" : `/archives/page/${pageNumber}/`;
---

<BaseLayout title={`全站归档 第 ${page} 页`} description="全部文章归档">
  <div class="archive-container">
    <SectionHeader
      title="全站归档"
      countText={`第 ${page} 页 / 共 ${pages} 页 · 共 ${posts.length} 篇`}
    />
    <PostList posts={pagePosts} />
    <Pagination currentPage={page} pages={pages} href={href} />
  </div>
</BaseLayout>

<style>
  .archive-container {
    padding: 1.5rem 0;
    width: 100%;
  }
</style>
