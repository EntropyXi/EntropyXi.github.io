---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE_DESCRIPTION, SITE_LANG, SITE_URL } from "@/data/site";
import { buildPageTitle } from "@/lib/seo/page-title";
import AmbientBackground from "@/components/visual/AmbientBackground.astro";
import SiteHeader from "@/components/chrome/SiteHeader.astro";
import MobileDrawer from "@/components/chrome/MobileDrawer.astro";
import SiteFooter from "@/components/chrome/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const pageTitle = buildPageTitle(title);
const pageDescription =
  description.trim() === "" ? SITE_DESCRIPTION : description.trim();
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html
  lang={SITE_LANG}
  class="no-js"
  data-theme="dark"
  data-is-home={isHome ? "true" : "false"}
  data-feature-reveal="true"
  data-feature-ambient="true"
  data-feature-magnetic="true"
  data-feature-gsap="true"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32-next.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16-next.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon-next.png"
    />
    <link rel="shortcut icon" href="/favicon.ico" />

    {
      isHome && (
        <link
          rel="preload"
          as="image"
          href="/images/hero/suisen-hero-1440w.webp"
          imagesrcset="/images/hero/suisen-hero-750w.webp 750w, /images/hero/suisen-hero-1440w.webp 1440w, /images/hero/suisen-hero-3840w.webp 3840w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }

    <!-- Theme & Client initialization script to prevent FOUC (reruns after every view-transition swap) -->
    <script is:inline data-astro-rerun>
      (function () {
        document.documentElement.classList.remove("no-js");
        document.documentElement.dataset.theme = "dark";

        try {
          const params = new URLSearchParams(window.location.search);
          const fReveal =
            params.get("feature-reveal") ??
            localStorage.getItem("entropyxi-feature-reveal");
          if (fReveal !== null) {
            document.documentElement.setAttribute(
              "data-feature-reveal",
              fReveal,
            );
          }
          const fAmbient =
            params.get("feature-ambient") ??
            localStorage.getItem("entropyxi-feature-ambient");
          if (fAmbient !== null) {
            document.documentElement.setAttribute(
              "data-feature-ambient",
              fAmbient,
            );
          }
          const fMagnetic =
            params.get("feature-magnetic") ??
            localStorage.getItem("entropyxi-feature-magnetic");
          if (fMagnetic !== null) {
            document.documentElement.setAttribute(
              "data-feature-magnetic",
              fMagnetic,
            );
          }
          const fGsap =
            params.get("feature-gsap") ??
            localStorage.getItem("entropyxi-feature-gsap");
          if (fGsap !== null) {
            document.documentElement.setAttribute("data-feature-gsap", fGsap);
          }

          // Hero entrance gate (plan §4.4): hide the hero only when the
          // choreography is actually eligible, and force-visibility after
          // 1.6s no matter what so a failed chunk load can never blank it.
          const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          const heroEligible =
            document.documentElement.dataset.isHome === "true" &&
            fGsap !== "false" &&
            !reducedMotion;
          if (heroEligible) {
            document.documentElement.setAttribute("data-hero-pending", "true");
            window.setTimeout(() => {
              document.documentElement.removeAttribute("data-hero-pending");
            }, 1600);
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳至主要内容</a>
    <div id="top"></div>
    <AmbientBackground isHome={isHome} />
    <SiteHeader isHome={isHome} />
    <!-- Body-level child (not inside <header>): the header's backdrop-filter
         would otherwise become the containing block for this fixed drawer. -->
    <MobileDrawer />
    <slot name="hero" />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { registerClientFeature } from "@/lib/client/lifecycle";
      import { initializeHeroFitTitle } from "@/lib/client/hero-fit-title";
      import { initializeMotionEnvironment } from "@/lib/client/motion-environment";
      import { initializeRevealController } from "@/lib/client/reveal-controller";
      import { initializeAmbientController } from "@/lib/client/ambient-controller";
      import { initializePointerController } from "@/lib/client/pointer-controller";
      import { initializeMotionRuntime } from "@/lib/client/motion/runtime";
      import { initializeMathScrollHints } from "@/lib/client/math-scroll-hint";

      // View-transition attribute relay (plan §4.2): the swap replaces every
      // <html> attribute with the new page's SSR values, dropping the runtime
      // state set by JS. Copy it onto the incoming document before the swap.
      interface BeforeSwapEvent extends Event {
        newDocument: Document;
      }

      const RUNTIME_ATTRIBUTES = [
        "data-motion",
        "data-motion-preference",
        "data-page-visibility",
        "data-feature-reveal",
        "data-feature-ambient",
        "data-feature-magnetic",
        "data-feature-gsap",
      ] as const;

      document.addEventListener("astro:before-swap", (event) => {
        const { newDocument } = event as BeforeSwapEvent;
        for (const attribute of RUNTIME_ATTRIBUTES) {
          const value = document.documentElement.getAttribute(attribute);
          if (value !== null) {
            newDocument.documentElement.setAttribute(attribute, value);
          }
        }
      });

      // Layout fix before motion features (plan 2026-09-06-hero-fit-title §3.2).
      registerClientFeature("hero-fit-title", initializeHeroFitTitle);
      registerClientFeature("motion-environment", initializeMotionEnvironment);
      registerClientFeature("reveal-controller", initializeRevealController);
      registerClientFeature("ambient-controller", initializeAmbientController);
      registerClientFeature("pointer-controller", initializePointerController);
      registerClientFeature("motion-runtime", initializeMotionRuntime);
      registerClientFeature("math-scroll-hint", initializeMathScrollHints);
    </script>
  </body>
</html>
