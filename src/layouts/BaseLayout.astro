---
import "@/styles/global.css";
import { SITE_DESCRIPTION, SITE_LANG, SITE_URL } from "@/data/site";
import { buildPageTitle } from "@/lib/seo/page-title";
import AmbientBackground from "@/components/visual/AmbientBackground.astro";
import SiteHeader from "@/components/chrome/SiteHeader.astro";
import SiteFooter from "@/components/chrome/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const pageTitle = buildPageTitle(title);
const pageDescription =
  description.trim() === "" ? SITE_DESCRIPTION : description.trim();
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html
  lang={SITE_LANG}
  class="no-js"
  data-theme="dark"
  data-feature-reveal="true"
  data-feature-ambient="true"
  data-feature-magnetic="true"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32-next.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16-next.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon-next.png"
    />
    <link rel="shortcut icon" href="/favicon.ico" />

    {
      isHome && (
        <link
          rel="preload"
          as="image"
          href="/images/hero/suisen-hero-1440w.webp"
          imagesrcset="/images/hero/suisen-hero-750w.webp 750w, /images/hero/suisen-hero-1440w.webp 1440w, /images/hero/suisen-hero-3840w.webp 3840w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }

    <!-- Theme & Client initialization script to prevent FOUC -->
    <script is:inline>
      (function () {
        document.documentElement.classList.remove("no-js");
        document.documentElement.dataset.theme = "dark";

        try {
          const params = new URLSearchParams(window.location.search);
          const fReveal =
            params.get("feature-reveal") ??
            localStorage.getItem("entropyxi-feature-reveal");
          if (fReveal !== null) {
            document.documentElement.setAttribute(
              "data-feature-reveal",
              fReveal,
            );
          }
          const fAmbient =
            params.get("feature-ambient") ??
            localStorage.getItem("entropyxi-feature-ambient");
          if (fAmbient !== null) {
            document.documentElement.setAttribute(
              "data-feature-ambient",
              fAmbient,
            );
          }
          const fMagnetic =
            params.get("feature-magnetic") ??
            localStorage.getItem("entropyxi-feature-magnetic");
          if (fMagnetic !== null) {
            document.documentElement.setAttribute(
              "data-feature-magnetic",
              fMagnetic,
            );
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳至主要内容</a>
    <div id="top"></div>
    <AmbientBackground isHome={isHome} />
    <SiteHeader isHome={isHome} />
    <slot name="hero" />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { registerClientFeature } from "@/lib/client/lifecycle";
      import { initializeMotionEnvironment } from "@/lib/client/motion-environment";
      import { initializeRevealController } from "@/lib/client/reveal-controller";
      import { initializeAmbientController } from "@/lib/client/ambient-controller";
      import { initializePointerController } from "@/lib/client/pointer-controller";

      registerClientFeature("motion-environment", initializeMotionEnvironment);
      registerClientFeature("reveal-controller", initializeRevealController);
      registerClientFeature("ambient-controller", initializeAmbientController);
      registerClientFeature("pointer-controller", initializePointerController);
    </script>
  </body>
</html>
