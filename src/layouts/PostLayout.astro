---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_URL } from "@/data/site";
import { formatPostDate } from "@/lib/date/format-date";
import { buildPostPath } from "@/lib/routing/post-path";
import "@/styles/prose.css";

interface PostLink {
  title: string;
  permalink: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
  prev: PostLink | undefined;
  next: PostLink | undefined;
}

const { post, headings, prev, next } = Astro.props;
const { data } = post;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const postUrl = new URL(buildPostPath(data.permalink), SITE_URL).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.date,
  dateModified: data.updated,
  url: postUrl,
});
---

<BaseLayout title={data.title} description={data.description}>
  <article class="post">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <header class="post-header">
      <h1 class="post-title">{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.date}>{formatPostDate(data.date)}</time>
        <span>分类：{data.categories.join(" / ")}</span>
      </div>
      <div class="post-tags" aria-label="文章标签">
        {data.tags.map((tag) => <span class="post-tag">{tag}</span>)}
      </div>
    </header>
    {
      toc.length > 0 && (
        <details class="post-toc" open>
          <summary>目录</summary>
          <ul>
            {toc.map((heading) => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
    <div class="prose" data-pagefind-body>
      <slot />
    </div>
    <nav class="post-pagination" aria-label="文章前后篇">
      {
        prev && (
          <a class="post-pagination-link" href={buildPostPath(prev.permalink)}>
            <span class="post-pagination-label">上一篇</span>
            <span>{prev.title}</span>
          </a>
        )
      }
      {
        next && (
          <a
            class="post-pagination-link post-pagination-link-next"
            href={buildPostPath(next.permalink)}
          >
            <span class="post-pagination-label">下一篇</span>
            <span>{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  function initCodeCopyButtons(): void {
    document.querySelectorAll("pre.astro-code").forEach((pre) => {
      if (pre.querySelector(".code-copy-button")) return;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      button.textContent = "复制";
      button.addEventListener("click", () => {
        const code = pre.querySelector("code")?.textContent ?? "";
        void navigator.clipboard.writeText(code).then(() => {
          button.textContent = "已复制";
          window.setTimeout(() => {
            button.textContent = "复制";
          }, 1500);
        });
      });
      const language = (pre as HTMLElement).dataset.language ?? "";
      if (language) {
        const label = document.createElement("span");
        label.className = "code-language-label";
        label.textContent = language;
        pre.appendChild(label);
      }
      pre.appendChild(button);
    });
  }

  initCodeCopyButtons();
  document.addEventListener("astro:page-load", initCodeCopyButtons);
</script>
