---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReadingProgress from "@/components/content/ReadingProgress.astro";
import FloatingControls from "@/components/content/FloatingControls.astro";
import { SITE_URL } from "@/data/site";
import { formatPostDate } from "@/lib/date/format-date";
import { buildPostPath } from "@/lib/routing/post-path";
import { buildTagPath } from "@/lib/content/aggregate";
import "@/styles/prose.css";

interface PostLink {
  title: string;
  permalink: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
  prev: PostLink | undefined;
  next: PostLink | undefined;
}

const { post, headings, prev, next } = Astro.props;
const { data } = post;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const postUrl = new URL(buildPostPath(data.permalink), SITE_URL).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.date,
  dateModified: data.updated,
  url: postUrl,
});
---

<BaseLayout title={data.title} description={data.description}>
  <ReadingProgress />

  <div class="post-layout-container">
    <!-- Main Article Content -->
    <article class="post-main">
      <script is:inline type="application/ld+json" set:html={jsonLd} />

      <header class="post-header">
        <h1 class="post-title">{data.title}</h1>

        <div class="post-meta">
          <span class="post-meta-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            <time datetime={data.date}>{formatPostDate(data.date)}</time>
          </span>

          {
            data.categories.length > 0 && (
              <span class="post-meta-item">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                </svg>
                <span>{data.categories.join(" / ")}</span>
              </span>
            )
          }
        </div>

        {
          data.tags.length > 0 && (
            <div class="post-tags" aria-label="文章标签">
              {data.tags.map((tag) => (
                <a href={buildTagPath(tag)} class="post-tag-badge">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <!-- Mobile Collapsible TOC -->
      {
        toc.length > 0 && (
          <details class="post-toc-mobile">
            <summary>
              <span>文章目录 ({toc.length})</span>
              <span>▼</span>
            </summary>
            <ul>
              {toc.map((heading) => (
                <li class={`toc-depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <div class="prose" data-pagefind-body>
        <slot />
      </div>

      <!-- Post Pagination (Prev / Next) -->
      {
        (prev || next) && (
          <nav class="post-pagination" aria-label="文章前后篇">
            {prev && (
              <a
                class="post-pagination-link"
                href={buildPostPath(prev.permalink)}
              >
                <span class="post-pagination-label">← 上一篇</span>
                <span class="post-pagination-title">{prev.title}</span>
              </a>
            )}
            {next && (
              <a
                class="post-pagination-link post-pagination-link-next"
                href={buildPostPath(next.permalink)}
              >
                <span class="post-pagination-label">下一篇 →</span>
                <span class="post-pagination-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <!-- Desktop Sticky TOC Sidebar -->
    {
      toc.length > 0 && (
        <aside class="post-sidebar" aria-label="文章目录">
          <div class="post-sidebar-title">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="21" x2="3" y1="6" y2="6" />
              <line x1="15" x2="3" y1="12" y2="12" />
              <line x1="17" x2="3" y1="18" y2="18" />
            </svg>
            <span>目录导览</span>
          </div>
          <ul class="post-toc-list">
            {toc.map((heading) => (
              <li class:list={["post-toc-item", `depth-${heading.depth}`]}>
                <a
                  href={`#${heading.slug}`}
                  class="post-toc-link"
                  title={heading.text}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <FloatingControls />
</BaseLayout>

<script>
  import { initializeCodeCopyButtons } from "@/lib/client/code-copy";
  import { registerClientFeature } from "@/lib/client/lifecycle";

  registerClientFeature("code-copy", initializeCodeCopyButtons);
</script>
