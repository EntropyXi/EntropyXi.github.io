---
// ReadingProgress.astro: Top reading progress indicator
---

<div
  id="reading-progress"
  class="reading-progress-bar"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="阅读进度"
>
</div>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: calc(var(--z-header) + 10);
    width: 0%;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-accent-cyan)
    );
    box-shadow: 0 0 10px var(--color-accent-glow);
    transition: width 50ms linear;
    pointer-events: none;
  }
</style>

<script>
  function initReadingProgress(): void {
    const bar = document.getElementById("reading-progress");
    if (!bar) return;

    let ticking = false;

    function updateProgress(): void {
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) {
        if (bar) bar.style.width = "0%";
        return;
      }
      const scrolled = window.scrollY;
      const progress = Math.min(100, Math.max(0, (scrolled / docHeight) * 100));
      if (bar) {
        bar.style.width = `${progress}%`;
        bar.setAttribute("aria-valuenow", Math.round(progress).toString());
      }
      ticking = false;
    }

    function onScroll(): void {
      if (!ticking) {
        window.requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    updateProgress();
  }

  initReadingProgress();
  document.addEventListener("astro:page-load", initReadingProgress);
</script>
