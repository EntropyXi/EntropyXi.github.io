---
// ReadingProgress.astro: Top reading progress indicator
---

<div
  id="reading-progress"
  class="reading-progress-bar"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="阅读进度"
>
</div>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: calc(var(--z-header) + 10);
    width: 0%;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-accent-cyan)
    );
    box-shadow: 0 0 10px var(--color-accent-glow);
    transition: width 50ms linear;
    pointer-events: none;
  }
</style>

<script>
  import { registerClientFeature } from "@/lib/client/lifecycle";
  import { initializeReadingProgress } from "@/lib/client/reading-progress";

  registerClientFeature("reading-progress", initializeReadingProgress);
</script>
