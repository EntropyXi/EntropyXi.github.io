---
// Hero.astro: Grand Narrative Hero Component with Demand-Loaded Original SDE Graphic
// Strictly adheres to docs/refactor/design-specs.md §6.2 and §8
import { buildTagPath } from "@/lib/content/aggregate";

interface ResearchTopic {
  label: string;
  tag: string;
}

// Strictly maps to verified existing tags generated in static build
const researchTopics: ResearchTopic[] = [
  { label: "流匹配与扩散模型", tag: "流匹配与扩散模型" },
  { label: "深度学习理论", tag: "深度学习" },
  { label: "数值分析与优化", tag: "数值分析" },
  { label: "概率论与随机过程", tag: "概率论" },
  { label: "生成式超分辨率", tag: "超分辨率" },
  { label: "信号与系统", tag: "信号与系统" },
];
---

<section class="hero-section" aria-label="欢迎首屏">
  <div class="hero-container">
    <!-- Left Narrative Column (55% on Desktop) -->
    <div class="hero-narrative">
      <!-- Announcement & Research Status Badge -->
      <div class="hero-status-badge">
        <span class="hero-status-pulse" aria-hidden="true"></span>
        <span class="hero-status-title">专题前沿</span>
        <span class="hero-status-divider" aria-hidden="true">/</span>
        <span class="hero-status-desc">SDE 扩散模型与流匹配理论推导</span>
      </div>

      <!-- Main Headline with Segmented Structure & Shimmer -->
      <div class="hero-title-group">
        <h1 class="hero-title">
          <span class="hero-title-segment segment-brand">EntropyXi</span>
          <span class="hero-title-segment segment-sub">的技术笔记</span>
        </h1>
        <p class="hero-subtitle">
          <span class="hero-subtitle-symbol" aria-hidden="true">&gt;</span>
          <span>探索生成式 AI、随机微分方程与连续流的数学交汇点</span>
        </p>
      </div>

      <!-- Narrative Lead Paragraph -->
      <p class="hero-lead">
        聚焦<strong>深度学习</strong>、<strong
          >扩散模型 (Diffusion Models)</strong
        >、<strong>流匹配 (Flow Matching)</strong>与<strong>数值分析</strong
        >的严谨数学推导、收敛性证明与高性能工程落地。
      </p>

      <!-- Research Topic Rails -->
      <div class="hero-topics-wrapper" aria-label="核心研究主题">
        <span class="hero-topics-label">研究主题</span>
        <div class="hero-topics-list">
          {
            researchTopics.map((topic) => (
              <a href={buildTagPath(topic.tag)} class="hero-topic-chip">
                <span class="hero-topic-hash" aria-hidden="true">
                  #
                </span>
                <span>{topic.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Call To Action Actions -->
      <div class="hero-actions">
        <a href="#latest-posts" class="hero-btn hero-btn-primary">
          <span>探索文章</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
        <a href="/categories/" class="hero-btn hero-btn-secondary">
          <span>分类图谱</span>
        </a>
        <a href="/archives/" class="hero-btn hero-btn-secondary">
          <span>全站归档</span>
        </a>
        <a href="/about/" class="hero-btn hero-btn-secondary">
          <span>关于博主</span>
        </a>
      </div>

      <!-- Scroll Indicator Hint -->
      <div class="hero-scroll-prompt">
        <a
          href="#latest-posts"
          class="hero-scroll-btn"
          aria-label="向下滚动至最新文章"
        >
          <span class="hero-scroll-text">向下探索</span>
          <svg
            class="hero-scroll-chevron"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 13l5 5 5-5M7 6l5 5 5-5"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Demand-Loaded SDE Flowfield Graphic Column (Desktop Only Asset) -->
    <div class="hero-graphic" aria-hidden="true">
      <div class="hero-graphic-card">
        <div class="hero-graphic-header">
          <div class="hero-graphic-dots">
            <span class="graphic-dot dot-red"></span>
            <span class="graphic-dot dot-amber"></span>
            <span class="graphic-dot dot-green"></span>
          </div>
          <span class="hero-graphic-label">Reverse-Time SDE Flowfield</span>
        </div>

        <div class="hero-svg-container">
          <picture>
            <source
              media="(max-width: 48rem)"
              srcset="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
            />
            <source
              media="(min-width: 48.01rem)"
              srcset="/images/hero-sde-flowfield.svg"
              type="image/svg+xml"
            />
            <img
              src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
              alt="Reverse-Time SDE Flowfield Graphic"
              class="hero-sde-svg"
              loading="lazy"
              decoding="async"
              width="520"
              height="400"
            />
          </picture>
        </div>

        <!-- Formula Caption Footer -->
        <div class="hero-graphic-footer">
          <span class="graphic-formula-symbol">SDE:</span>
          <code class="graphic-formula-code"
            >dx = [f(x,t) - g(t)²∇log p_t(x)]dt + g(t)dw̄</code
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 3rem 0 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-default);
    width: 100%;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    max-width: var(--max-width-wide);
    margin: 0 auto;
  }

  /* Left Narrative Column */
  .hero-narrative {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    width: 100%;
  }

  /* Status Badge */
  .hero-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    box-shadow: 0 0 15px var(--color-accent-primary-subtle);
  }

  .hero-status-pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-accent-primary);
    box-shadow: 0 0 8px var(--color-accent-primary-glow);
    animation: pulse-dot var(--motion-duration-pulse) var(--motion-ease-pulse)
      infinite;
  }

  .hero-status-title {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .hero-status-divider {
    color: var(--color-border-default);
  }

  .hero-status-desc {
    color: var(--color-text-secondary);
  }

  /* Title Group */
  .hero-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hero-title {
    margin: 0;
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .hero-title-segment {
    display: inline-block;
    opacity: 1;
    transform: none;
    animation: hero-title-reveal var(--motion-duration-slow)
      var(--motion-ease-standard) both;
  }

  .segment-sub {
    animation-delay: 100ms;
  }

  .segment-brand {
    background: linear-gradient(
      120deg,
      var(--color-text-primary) 0%,
      var(--color-accent-primary) 45%,
      var(--color-accent-cyan) 80%,
      var(--color-text-primary) 100%
    );
    background-size: 200% auto;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation:
      hero-title-reveal var(--motion-duration-slow) var(--motion-ease-standard)
        both,
      cyber-shimmer 8000ms linear infinite 800ms;
  }

  @keyframes hero-title-reveal {
    from {
      opacity: 0.3;
      transform: translateY(4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cyber-shimmer {
    0% {
      background-position: 0% 50%;
    }

    100% {
      background-position: 200% 50%;
    }
  }

  .hero-subtitle {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--color-accent-cyan);
    font-weight: 600;
  }

  .hero-subtitle-symbol {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  /* Lead Description */
  .hero-lead {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 44rem;
  }

  .hero-lead strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Topic Rails */
  .hero-topics-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .hero-topics-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .hero-topics-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard),
      background-color var(--motion-duration-fast) var(--motion-ease-standard),
      box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
      transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .hero-topic-chip:hover,
  .hero-topic-chip:focus-visible {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: var(--color-accent-primary-subtle);
    box-shadow: 0 0 10px var(--color-accent-primary-glow);
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .hero-topic-hash {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  /* CTA Buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard),
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      box-shadow var(--motion-duration-fast) var(--motion-ease-standard),
      transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .hero-btn-primary {
    background: var(--color-accent-primary);
    color: var(--color-accent-contrast);
    border: 1px solid var(--color-accent-primary);
    box-shadow: 0 0 20px var(--color-accent-primary-glow);
  }

  .hero-btn-primary:hover,
  .hero-btn-primary:focus-visible {
    background: var(--color-accent-primary);
    color: var(--color-accent-contrast);
    transform: translateY(-2px);
    box-shadow: 0 0 28px var(--color-accent-primary-glow);
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .hero-btn-primary:active {
    transform: translateY(0) scale(0.98);
  }

  .hero-btn-secondary {
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-primary);
  }

  .hero-btn-secondary:hover,
  .hero-btn-secondary:focus-visible {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: var(--color-accent-primary-subtle);
    transform: translateY(-2px);
    box-shadow: 0 0 16px var(--color-accent-primary-glow);
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .hero-btn-secondary:active {
    transform: translateY(0) scale(0.98);
  }

  /* Scroll Indicator Hint */
  .hero-scroll-prompt {
    display: flex;
    align-items: center;
    margin-top: 0.25rem;
  }

  .hero-scroll-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    transition:
      color var(--motion-duration-fast) var(--motion-ease-standard),
      transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .hero-scroll-btn:hover,
  .hero-scroll-btn:focus-visible {
    color: var(--color-accent-primary);
    transform: translateY(2px);
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .hero-scroll-chevron {
    animation: scroll-bounce 2400ms ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.7;
    }

    50% {
      transform: translateY(3px);
      opacity: 1;
    }
  }

  /* Right Graphic Panel */
  .hero-graphic {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .hero-graphic-card {
    position: relative;
    width: 100%;
    max-width: 32rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface-glass);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--color-border-default);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .hero-graphic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-surface-base);
  }

  .hero-graphic-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .graphic-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--radius-full);
  }

  .dot-red {
    background: #ef4444;
  }

  .dot-amber {
    background: #f59e0b;
  }

  .dot-green {
    background: #10b981;
  }

  .hero-graphic-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .hero-svg-container {
    padding: 1rem 0.5rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-sde-svg {
    width: 100%;
    height: auto;
    max-height: 19rem;
    display: block;
  }

  .hero-graphic-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--color-border-default);
    background: var(--color-surface-base);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .graphic-formula-symbol {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .graphic-formula-code {
    color: var(--color-text-secondary);
    font-size: 0.74rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  /* Responsive Matrix */
  @media (width <= 64rem) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-graphic {
      max-width: 28rem;
      margin: 0 auto;
    }
  }

  @media (width <= 48rem) {
    .hero-section {
      padding: 2rem 0 1.75rem;
      margin-bottom: 1.75rem;
    }

    .hero-title {
      font-size: 2.15rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .hero-lead {
      font-size: 1rem;
    }

    .hero-graphic {
      display: none;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-btn {
      flex: 1 1 calc(50% - 0.5rem);
      min-width: 8.5rem;
    }
  }

  @media (width <= 25rem) {
    .hero-title {
      font-size: 1.85rem;
    }

    .hero-btn {
      flex: 1 1 100%;
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .hero-title-segment,
    .segment-brand,
    .hero-scroll-chevron,
    .hero-status-pulse {
      animation: none !important;
    }

    .hero-btn-primary:hover,
    .hero-btn-primary:focus-visible,
    .hero-btn-secondary:hover,
    .hero-btn-secondary:focus-visible,
    .hero-scroll-btn:hover,
    .hero-scroll-btn:focus-visible,
    .hero-topic-chip:hover,
    .hero-topic-chip:focus-visible {
      transform: none !important;
    }
  }
</style>
