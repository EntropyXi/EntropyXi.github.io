---
// AmbientBackground.astro: Original ambient background with persistent fixed wallpaper on homepage
// Layer 1: Cyber Grid (Disabled per user request)
// Layer 2: Scanline (Subtle neon sweep)
// Layer 3: Local Glow (Primary + Cyan Neon Orbs)
// Layer 4: Mathematical Streamline Flow (Low-density SDE vector paths)
// Strictly pointer-events: none, aria-hidden="true", independent layer toggleable
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<div class="ambient-background" aria-hidden="true">
  {
    isHome && (
      <div class="ambient-wallpaper-container">
        <picture class="ambient-wallpaper-picture">
          <source
            media="(max-width: 48rem)"
            type="image/webp"
            srcset="/images/hero/suisen-hero-750w.webp"
          />
          <source
            media="(max-width: 90rem)"
            type="image/webp"
            srcset="/images/hero/suisen-hero-1440w.webp"
          />
          <source
            type="image/webp"
            srcset="/images/hero/suisen-hero-3840w.webp"
          />
          <img
            src="/images/hero/suisen-hero-1440w.webp"
            alt=""
            class="ambient-wallpaper-img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1920"
            height="1080"
          />
        </picture>
        <div class="ambient-wallpaper-scrim" />
      </div>
    )
  }

  <!-- Layer 1: Cyber Grid (Disabled per user request) -->
  <div class="ambient-layer ambient-grid-layer" data-layer="grid"></div>

  <!-- Layer 2: Ambient Scanline -->
  <div class="ambient-layer ambient-scanline-layer" data-layer="scanline"></div>

  <!-- Layer 3: Local Glow Orbs -->
  <div class="ambient-layer ambient-glow-layer" data-layer="glow">
    <div class="ambient-glow-orb glow-orb-primary"></div>
    <div class="ambient-glow-orb glow-orb-cyan"></div>
    <div class="ambient-glow-orb glow-orb-pointer"></div>
  </div>

  <!-- Layer 4: Low-density SVG Mathematical Streamline Flow -->
  <div class="ambient-layer ambient-flow-layer" data-layer="flow">
    <svg
      class="ambient-flow-svg"
      viewBox="0 0 1440 900"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="xMidYMid slice"
    >
      <path
        d="M-100 250 C 300 150, 700 450, 1100 300 C 1300 220, 1500 280, 1600 320"
        stroke="var(--color-ambient-streamline)"
        stroke-width="1.5"
        stroke-dasharray="8 12"
        opacity="0.6"></path>
      <path
        d="M-50 480 C 350 380, 650 680, 1050 520 C 1250 440, 1450 500, 1550 540"
        stroke="var(--color-accent-primary-subtle)"
        stroke-width="1.2"
        stroke-dasharray="6 10"
        opacity="0.5"></path>
      <path
        d="M100 700 C 500 600, 800 850, 1200 720 C 1350 670, 1500 710, 1600 730"
        stroke="var(--color-ambient-streamline)"
        stroke-width="1"
        stroke-dasharray="4 8"
        opacity="0.4"></path>
    </svg>
  </div>
</div>

<style>
  .ambient-background {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    z-index: var(--z-bg);
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    clip-path: inset(0);
    background-color: var(--color-bg-canvas);
  }

  /* Persistent fixed wallpaper across entire page */
  .ambient-wallpaper-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .ambient-wallpaper-picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ambient-wallpaper-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .ambient-wallpaper-scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        ellipse 80% 80% at 20% 30%,
        rgb(10 12 22 / 72%) 0%,
        rgb(10 12 22 / 52%) 60%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        rgb(10 12 22 / 50%) 0%,
        rgb(10 12 22 / 60%) 45%,
        rgb(15 18 33 / 82%) 100%
      );
  }

  .ambient-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Layer 1: Cyber Grid (Disabled per user request) */
  .ambient-grid-layer {
    display: none;
  }

  /* Layer 2: Ambient Scanline */
  .ambient-scanline-layer {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-ambient-scanline) 50%,
      transparent 100%
    );
    height: 12rem;
    opacity: 0.8;
    animation: scanline-sweep var(--motion-duration-ambient) linear infinite;
  }

  /* Layer 3: Glow Orbs */
  .ambient-glow-layer {
    overflow: hidden;
  }

  .ambient-glow-orb {
    position: absolute;
    border-radius: var(--radius-full);
    filter: blur(80px);
    opacity: 0.16;
    pointer-events: none;
  }

  .glow-orb-primary {
    top: -8rem;
    left: 15%;
    width: 32rem;
    height: 32rem;
    max-width: 80vw;
    background: radial-gradient(
      circle,
      var(--color-accent-primary) 0%,
      transparent 70%
    );
  }

  .glow-orb-cyan {
    top: 14rem;
    right: 8%;
    width: 28rem;
    height: 28rem;
    max-width: 70vw;
    background: radial-gradient(
      circle,
      var(--color-accent-cyan) 0%,
      transparent 70%
    );
    opacity: 0.12;
  }

  .glow-orb-pointer {
    top: 0;
    left: 0;
    width: 22rem;
    height: 22rem;
    margin-top: -11rem;
    margin-left: -11rem;
    transform: translate3d(
      var(--pointer-x, -999px),
      var(--pointer-y, -999px),
      0
    );
    background: radial-gradient(
      circle,
      var(--color-accent-primary-subtle) 0%,
      transparent 70%
    );
    opacity: 0.45;
    pointer-events: none;
    filter: blur(50px);
    transition: opacity var(--motion-duration-normal)
      var(--motion-ease-standard);
    will-change: transform;
  }

  :global(html[data-theme="light"]) .glow-orb-pointer {
    opacity: 0.22;
  }

  :global(html:not([data-motion="ready"])) .glow-orb-pointer,
  :global(html[data-motion-preference="reduced"]) .glow-orb-pointer,
  :global(html[data-feature-magnetic="false"]) .glow-orb-pointer {
    display: none !important;
  }

  /* Layer 4: Mathematical Streamline Flow */
  .ambient-flow-layer {
    overflow: hidden;
  }

  .ambient-flow-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(html[data-theme="light"]) .ambient-glow-orb {
    opacity: 0.08;
  }

  /* Mobile & Touch Responsive Degradation */
  @media (width <= 48rem), (hover: none) {
    .ambient-scanline-layer {
      display: none;
    }

    .ambient-flow-layer {
      display: none;
    }

    .ambient-glow-orb {
      filter: blur(40px);
    }

    .glow-orb-primary {
      top: -4rem;
      left: 0;
      width: 16rem;
      height: 16rem;
    }

    .glow-orb-cyan {
      display: none;
    }

    .glow-orb-pointer {
      display: none;
    }
  }
</style>
