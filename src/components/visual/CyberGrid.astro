---
// CyberGrid.astro: Pure CSS/SVG subtle cyber grid and ambient glow background
---

<div class="cyber-grid-bg" aria-hidden="true">
  <div class="cyber-glow-orb cyber-glow-orb-1"></div>
  <div class="cyber-glow-orb cyber-glow-orb-2"></div>
  <div class="cyber-grid-pattern"></div>
</div>

<style>
  .cyber-grid-bg {
    position: fixed;
    inset: 0;
    z-index: var(--z-bg);
    overflow: hidden;
    pointer-events: none;
  }

  .cyber-grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        to right,
        var(--color-border-subtle) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        var(--color-border-subtle) 1px,
        transparent 1px
      );
    background-size: 3rem 3rem;
    opacity: 0.6;
    mask-image: radial-gradient(
      ellipse 80% 60% at 50% 10%,
      #000 60%,
      transparent 100%
    );
  }

  .cyber-glow-orb {
    position: absolute;
    border-radius: var(--radius-full);
    filter: blur(80px);
    opacity: 0.15;
    transition: opacity var(--transition-normal);
  }

  .cyber-glow-orb-1 {
    top: -10rem;
    left: 20%;
    width: 35rem;
    height: 35rem;
    background: radial-gradient(
      circle,
      var(--color-accent) 0%,
      transparent 70%
    );
  }

  .cyber-glow-orb-2 {
    top: 15rem;
    right: 10%;
    width: 30rem;
    height: 30rem;
    background: radial-gradient(
      circle,
      var(--color-accent-cyan) 0%,
      transparent 70%
    );
    opacity: 0.1;
  }

  :global(html[data-theme="light"]) .cyber-grid-pattern {
    opacity: 0.4;
  }

  :global(html[data-theme="light"]) .cyber-glow-orb {
    opacity: 0.08;
  }
</style>
