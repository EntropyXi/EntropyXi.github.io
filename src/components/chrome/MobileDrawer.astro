---
// MobileDrawer.astro: right-side navigation drawer.
// Rendered as a direct child of <body> (plan 2026-09-05-mobile-fixes §3.1):
// keeping it inside <header> made the header's backdrop-filter the containing
// block for this fixed element, collapsing `inset: 0` to the 64px header box
// and breaking the drawer's panel/backdrop on every mobile viewport.
import { isNavActive, NAV_ITEMS } from "@/lib/navigation";

const currentPath = Astro.url.pathname;
---

<div
  id="mobile-drawer"
  class="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-drawer-title"
  aria-hidden="true"
>
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
  <div
    class="mobile-drawer-content"
    id="mobile-drawer-content"
    data-lenis-prevent
  >
    <div class="mobile-drawer-header">
      <span id="mobile-drawer-title" class="mobile-drawer-title">
        导航目录
      </span>
      <button
        type="button"
        id="mobile-drawer-close"
        class="mobile-drawer-close"
        aria-label="关闭菜单"
      >
        ✕
      </button>
    </div>
    <nav class="mobile-nav" aria-label="移动端导航">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class:list={[
              "mobile-nav-link",
              { active: isNavActive(item.href, currentPath) },
            ]}
            aria-current={
              isNavActive(item.href, currentPath) ? "page" : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="https://github.com/EntropyXi"
        class="mobile-nav-link mobile-nav-link-external"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub 个人主页
      </a>
    </nav>
  </div>
</div>

<style>
  /* Mobile Drawer (JS Enhanced) */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    display: none;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-drawer-backdrop);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--motion-duration-normal)
      var(--motion-ease-standard);
  }

  .mobile-drawer.open .mobile-drawer-backdrop {
    opacity: 1;
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 18rem;
    max-width: 85vw;
    background: var(--color-surface-raised);
    border-left: 1px solid var(--color-border-default);
    box-shadow: -4px 0 25px rgb(0 0 0 / 50%);
    transform: translateX(100%);
    transition: transform var(--motion-duration-normal)
      var(--motion-ease-standard);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    backdrop-filter: var(--glass-blur);
  }

  .mobile-drawer.open .mobile-drawer-content {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-default);
    margin-bottom: 1.25rem;
  }

  .mobile-drawer-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .mobile-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.25rem 0.5rem;
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 1rem;
    cursor: pointer;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .mobile-drawer-close:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: 0.98rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .mobile-nav-link:hover {
    background: var(--color-accent-primary-subtle);
    color: var(--color-accent-primary);
  }

  .mobile-nav-link.active {
    background: var(--color-accent-primary-subtle);
    color: var(--color-accent-primary);
    font-weight: 600;
    border-left: 3px solid var(--color-accent-primary);
  }
</style>
