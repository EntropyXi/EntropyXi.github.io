---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "@/data/site";

const currentPath = Astro.url.pathname;

const navItems = [
  { label: "首页", href: "/" },
  { label: "归档", href: "/archives/" },
  { label: "分类", href: "/categories/" },
  { label: "标签", href: "/tags/" },
  { label: "关于", href: "/about/" },
  { label: "搜索", href: "/search/" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="site-brand">
      <a href="/" class="site-logo-link">
        <span class="site-logo-symbol">Ξ</span>
        <span class="site-logo-text">{SITE_TITLE}</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="https://github.com/EntropyXi"
        class="nav-link nav-link-external"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 个人主页"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <ThemeToggle />
    </nav>

    <!-- Mobile Menu Button & Theme Toggle -->
    <div class="mobile-actions">
      <ThemeToggle />
      <button
        type="button"
        id="mobile-menu-btn"
        class="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="打开导航菜单"
      >
        <svg
          class="menu-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
    <div class="mobile-drawer-content">
      <div class="mobile-drawer-header">
        <span class="mobile-drawer-title">导航目录</span>
        <button
          type="button"
          id="mobile-drawer-close"
          class="mobile-drawer-close"
          aria-label="关闭菜单"
        >
          ✕
        </button>
      </div>
      <nav class="mobile-nav" aria-label="移动端导航">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={["mobile-nav-link", { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="https://github.com/EntropyXi"
          class="mobile-nav-link mobile-nav-link-external"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub 个人主页
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    width: 100%;
    height: var(--header-height);
    background: rgb(9 13 22 / 80%);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-header);
    transition: background var(--transition-normal);
  }

  :global(html[data-theme="light"]) .site-header {
    background: rgb(248 250 252 / 85%);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--max-width-wide);
    height: 100%;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .site-brand {
    display: flex;
    align-items: center;
  }

  .site-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-logo-symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 1rem;
    box-shadow: 0 0 10px var(--color-accent-glow);
  }

  .site-logo-link:hover .site-logo-text {
    color: var(--color-accent);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-muted-soft);
  }

  .nav-link.active {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    font-weight: 600;
  }

  .nav-link-external {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.5rem;
  }

  .mobile-actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-menu-btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    display: none;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 60%);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .mobile-drawer.open .mobile-drawer-backdrop {
    opacity: 1;
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 18rem;
    max-width: 85vw;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    box-shadow: -4px 0 25px rgb(0 0 0 / 50%);
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
  }

  .mobile-drawer.open .mobile-drawer-content {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .mobile-drawer-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .mobile-drawer-close {
    padding: 0.25rem 0.5rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1rem;
    cursor: pointer;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background: var(--color-surface-hover);
    color: var(--color-accent);
  }

  .mobile-nav-link.active {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (width <= 48rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }
  }
</style>

<script>
  import { registerClientFeature } from "@/lib/client/lifecycle";
  import { initializeMobileDrawer } from "@/lib/client/mobile-drawer";

  registerClientFeature("mobile-drawer", initializeMobileDrawer);
</script>
