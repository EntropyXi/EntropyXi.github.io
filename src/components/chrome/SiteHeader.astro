---
import { SITE_TITLE } from "@/data/site";
import { isNavActive, NAV_ITEMS } from "@/lib/navigation";

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class:list={["site-header", { "site-header-home": isHome }]}
  data-site-header
  data-header-state="expanded"
  data-is-home={isHome ? "true" : "false"}
>
  <div class="site-header-inner">
    <div class="site-brand">
      <a href="/" class="site-logo-link" data-magnetic>
        <img
          src="/images/avatar-suisen.webp"
          alt="EntropyXi"
          class="site-logo-avatar"
          width="32"
          height="32"
          loading="eager"
          decoding="async"
        />
        <span class="site-logo-text">{SITE_TITLE}</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="主导航">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link",
              { active: isNavActive(item.href, currentPath) },
            ]}
            aria-current={
              isNavActive(item.href, currentPath) ? "page" : undefined
            }
            data-magnetic
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="https://github.com/EntropyXi"
        class="nav-link nav-link-external"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 个人主页"
        data-magnetic
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
    </nav>

    <!-- Mobile Actions (Menu button) -->
    <div class="mobile-actions">
      <button
        type="button"
        id="mobile-menu-btn"
        class="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="打开导航菜单"
      >
        <svg
          class="menu-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- No-JS Mobile Navigation Fallback -->
  <noscript>
    <div class="mobile-noscript-nav-container">
      <nav class="mobile-noscript-nav" aria-label="无脚本主导航">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class:list={[
                "mobile-noscript-nav-link",
                { active: isNavActive(item.href, currentPath) },
              ]}
              aria-current={
                isNavActive(item.href, currentPath) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </noscript>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    width: 100%;
    height: var(--header-height);
    background: var(--color-surface-glass);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--color-border-default);
    box-shadow: var(--shadow-header);
    transition:
      background var(--motion-duration-normal) var(--motion-ease-standard),
      background-color var(--motion-duration-normal) var(--motion-ease-standard),
      border-color var(--motion-duration-normal) var(--motion-ease-standard),
      box-shadow var(--motion-duration-normal) var(--motion-ease-standard);
  }

  /* Homepage Floating Header over Hero (0-CLS height stability) */
  .site-header.site-header-home {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  .site-header.site-header-home[data-header-state="expanded"] {
    background: linear-gradient(
      180deg,
      rgb(10 12 22 / 88%) 0%,
      rgb(10 12 22 / 50%) 60%,
      transparent 100%
    );
    backdrop-filter: blur(8px);
    border-bottom-color: rgb(245 158 11 / 15%);
    box-shadow: none;
  }

  .site-header.site-header-home[data-header-state="compact"] {
    background: var(--color-surface-glass);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--color-border-default);
    box-shadow: var(--shadow-header);
  }

  /* Reserved CSS Contract for Main Agent's Header State */
  .site-header[data-header-state="expanded"] {
    height: var(--header-height);
  }

  .site-header[data-header-state="compact"] {
    height: var(--header-height-scrolled);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--max-width-wide);
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5.5vw, 5.5rem);
  }

  .site-brand {
    display: flex;
    align-items: center;
  }

  .site-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text-primary);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .site-logo-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-accent-primary);
    box-shadow: 0 0 10px var(--color-accent-primary-glow);
    object-fit: cover;
    display: block;
    transition: transform var(--motion-duration-fast)
      var(--motion-ease-standard);
  }

  .site-logo-link:hover .site-logo-avatar {
    transform: rotate(8deg) scale(1.08);
  }

  .site-logo-link:hover .site-logo-text {
    color: var(--color-accent-primary);
  }

  .site-header.site-header-home[data-header-state="expanded"] .site-logo-link {
    color: #fff;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-ease-standard),
      background-color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-subtle);
  }

  .nav-link.active {
    color: var(--color-accent-primary);
    background: var(--color-accent-primary-subtle);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    bottom: -0.85rem;
    left: 0.75rem;
    right: 0.75rem;
    height: 2px;
    background: var(--color-accent-primary);
    box-shadow: 0 0 8px var(--color-accent-primary-glow);
  }

  .site-header.site-header-home[data-header-state="expanded"] .nav-link {
    color: var(--color-text-secondary);
  }

  .site-header.site-header-home[data-header-state="expanded"] .nav-link:hover {
    color: #fff;
    background: rgb(245 158 11 / 18%);
  }

  .nav-link-external {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.5rem;
  }

  .mobile-actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface-base);
    color: var(--color-text-primary);
    cursor: pointer;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease-standard),
      color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .mobile-menu-btn:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .mobile-menu-btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  :global(.no-js) .mobile-menu-btn {
    display: none;
  }

  /* No-JS Mobile Navigation */
  .mobile-noscript-nav-container {
    display: none;
    padding: 0.5rem 1rem;
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border-default);
  }

  .mobile-noscript-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .mobile-noscript-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .mobile-noscript-nav-link:hover,
  .mobile-noscript-nav-link.active {
    color: var(--color-accent-primary);
    background: var(--color-accent-primary-subtle);
  }

  @media (width <= 48rem) {
    .site-header-inner {
      padding: 0 1rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }

    .mobile-noscript-nav-container {
      display: block;
    }
  }
</style>

<script>
  import { registerClientFeature } from "@/lib/client/lifecycle";
  import { initializeMobileDrawer } from "@/lib/client/mobile-drawer";
  import { initializeSiteHeaderState } from "@/lib/client/site-header";

  registerClientFeature("mobile-drawer", initializeMobileDrawer);
  registerClientFeature("site-header-state", initializeSiteHeaderState);
</script>
