---
// SiteFooter.astro: Clean Cyberpunk Footer with verified static status
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-status">
      <span class="status-pulse" aria-hidden="true"></span>
      <span>System Status: <strong>SSG Ready</strong></span>
    </div>
    <div class="site-footer-copy">
      <p>
        © 2026 EntropyXi · Built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro 7</a
        > & <a
          href="https://github.com/EntropyXi"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-default);
    background: var(--color-bg-base);
    color: var(--color-text-muted);
    padding: 2.25rem 1.5rem;
    font-size: 0.88rem;
    margin-top: auto;
    width: 100%;
    transition:
      background-color var(--motion-duration-normal) var(--motion-ease-standard),
      border-color var(--motion-duration-normal) var(--motion-ease-standard);
  }

  .site-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    text-align: center;
  }

  .site-footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .status-pulse {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-accent-primary);
    box-shadow: 0 0 8px var(--color-accent-primary-glow);
    animation: pulse-dot var(--motion-duration-pulse) var(--motion-ease-pulse)
      infinite;
  }

  .site-footer-copy p {
    margin: 0;
  }

  .site-footer a {
    /* Inline-block + negative margin enlarges the touch target to ≥24px
       tall (mobile fixes plan §3.3) without shifting the line layout. The
       focus outline shifts outward by the padding — accepted deviation. */
    display: inline-block;
    padding: 0.3rem 0.2rem;
    margin: -0.3rem -0.2rem;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .site-footer a:hover {
    color: var(--color-accent-primary);
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }
</style>
