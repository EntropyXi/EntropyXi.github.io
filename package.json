{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "npm run build:site && npm run build:search",
    "build:site": "npm run copy:vendor && astro build",
    "check": "npm run format:check && npm run lint && npm run check:types && npm run audit:content && npm run test:unit -- --run && npm run test:e2e && npm run audit:output",
    "check:types": "astro check",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "legacy:clean": "hexo clean",
    "legacy:build": "hexo generate",
    "legacy:check": "npm run audit:frontmatter && npm run legacy:clean && npm run legacy:build && npm run verify",
    "legacy:server": "hexo server",
    "legacy:deploy": "hexo deploy",
    "verify": "node scripts/verify-build.js",
    "audit:frontmatter": "node scripts/audit-frontmatter.js",
    "copy:vendor": "tsx scripts/copy-vendor-assets.ts",
    "migrate:content": "tsx scripts/migrate-content.ts",
    "audit:content": "tsx scripts/audit-content.ts",
    "build:search": "pagefind --site dist",
    "audit:output": "tsx scripts/audit-output.ts"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "astro": "^7.2.4",
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-pandoc": "^0.5.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-theme-next": "^8.27.0",
    "hexo-wordcount": "^6.0.1",
    "mathjax": "^3.2.2",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^1.7.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  }
}
